    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $input.item.json;\nconst msg = String(e.execution?.error?.message ?? \"Unknown error\");\nconst workflow = e.workflow?.name ?? \"unknown workflow\";\nconst node = e.execution?.lastNodeExecuted ?? \"unknown node\";\nconst url = e.execution?.url ?? \"\";\n\nconst severity = /rate limit|429|credit|unauthorized|401/i.test(msg)\n  ? \"high\"\n  : \"medium\";\n\nreturn {\n  json: {\n    workflow_name: workflow,\n    node_name: node,\n    error_message: msg.slice(0, 500),\n    execution_id: String(e.execution?.id ?? \"\"),\n    execution_url: url,\n    severity,\n    status: \"open\",\n    alert_text: `ALERT (${severity}): ${workflow} failed at ${node}\\n${msg.slice(0, 300)}\\n${url}`\n  }\n};"
      },
