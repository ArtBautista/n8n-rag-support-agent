    {
      "parameters": {
        "jsCode": "const cases = $('Keep Retrieval Cases').all().map((i) => i.json);\nconst replies = $input.all().map((i) => i.json);\n\nreturn replies.map((reply, index) => {\n  const testCase = cases[index];\n\n  const expected = String(testCase.expected_article ?? \"\")\n    .split(\",\")\n    .map((s) => s.trim())\n    .filter(Boolean);\n\n  const returned = (reply.results ?? []).map((r) => r.article_id);\n\n  const top1 = expected.includes(returned[0]);\n  const recall3 = expected.every((id) => returned.slice(0, 3).includes(id));\n\n  return {\n    json: {\n      test_id: testCase.test_id,\n      expected: expected.join(\",\"),\n      returned: returned.join(\",\"),\n      top1,\n      recall3\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -96
      ],
      "id": "d1e36753-4311-4d6b-9264-e87f5d7edd2c",
      "name": "Score Retrieval"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((i) => i.json);\nconst n = rows.length;\nconst pct = (x) => (n ? Math.round((x / n) * 100) : 0);\n\nconst top1 = pct(rows.filter((r) => r.top1).length);\nconst recall3 = pct(rows.filter((r) => r.recall3).length);\nconst misses = rows.filter((r) => !r.recall3).map((r) => r.test_id);\n\nreturn [{\n  json: {\n    total: n,\n    top1_accuracy: top1,\n    recall_at_3: recall3,\n    misses,\n    message: `Retrieval run ${$execution.id}: Top-1 ${top1}%, Recall@3 ${recall3}% over ${n} questions. Misses: ${misses.join(\", \") || \"none\"}`\n  }\n}];"
      },
