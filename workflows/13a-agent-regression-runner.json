    {
      "parameters": {
        "jsCode": "const rows = $('Assert Results').all().map((i) => i.json);\nconst failed = rows.filter((r) => r.result === \"FAIL\");\nconst passed = rows.length - failed.length;\nconst rate = rows.length ? Math.round((passed / rows.length) * 100) : 0;\n\nconst failures = failed.map((f) => `${f.test_id} (${f.reason})`).join(\"; \");\nconst message =\n  `Agent regression run ${$execution.id}: ${passed}/${rows.length} passed (${rate}%).` +\n  (failed.length ? `\\nFailed: ${failures}` : \"\");\n\nreturn [{ json: { total: rows.length, passed, pass_rate: rate, message: message.slice(0, 1800) } }];"
      },
