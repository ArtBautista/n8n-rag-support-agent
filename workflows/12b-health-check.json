        "options": {
          "timeout": 5000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        208,
        208
      ],
      "id": "91a39f35-e7f3-4244-8da6-6468b3619aae",
      "name": "Check Ollama"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const models = ($input.item.json.models ?? []).map((m) => m.name);\n\nif (!models.some((n) => n.startsWith(\"nomic-embed-text\"))) {\n  throw new Error(\"Ollama is up but nomic-embed-text is not installed.\");\n}\n\nreturn { json: { ok: true } };"
      },
      "type": "n8n-nodes-base.code",
