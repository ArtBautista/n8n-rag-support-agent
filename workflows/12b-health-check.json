      "name": "Check Collection"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const info = $input.item.json.result ?? {};\n\nif (info.status !== \"green\" || !(info.points_count > 0)) {\n  throw new Error(\n    `Collection unhealthy: status=${info.status}, points=${info.points_count}`\n  );\n}\n\nreturn { json: { ok: true, points: info.points_count } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "7f5b122e-85ed-44e2-8a6f-9678c9b169f6",
